generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Capacitacion {
  id          Int      @id @default(autoincrement())
  titulo      String
  duracion    String
  badge       String
  badgeColor  String   @default("navy")
  descripcion String
  temas       Json     @default("[]")
  icono       String
  publico     String
  modalidad   String
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipo {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  icono       String
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  value     String
  updatedAt DateTime @updatedAt @default(now())
}

model BlogPost {
  id               Int       @id @default(autoincrement())
  titulo           String
  slug             String    @unique
  contenido        String
  resumen          String
  imagen           String?
  categoria        String    @default("General")
  publicado        Boolean   @default(false)
  fechaPublicacion DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
